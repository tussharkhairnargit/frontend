{
  "name": "grayscale-css",
  "version": "1.0.0",
  "author": "Tushar Khairnar",
  "files": [
    "build/*.css"
  ],
  "style": "build/grayscale.css",
  "exports": {
    ".": {
      "style": "./build/grayscale.css",
      "default": "./build/grayscale.css"
    },
    "./min": "./build/grayscale.min.css"
  },
  "scripts": {
    "// --- Lightning CSS : Build Tasks --- //": "alternative of comment",
    "build:expanded": "lightningcss --bundle src/index.css -o build/grayscale.css",
    "build:minified": "lightningcss --bundle --minify src/index.css -o build/grayscale.min.css",
    "build": "npm run build:expanded && npm run build:minified",
    "dev:watch": "lightningcss --bundle --watch src/index.css -o build/grayscale.css",
    "dev:serve": "http-server build",
    "lint": "stylelint src/**/*.css",
     "pack:local": "npm pack --pack-destination build"

  },
  "xscripts": {
    "note": " only one script can be present. remove x to apply below scripts",
    "// --- esbuild Tasks --- //": "While tools like esbuild just strip whitespace, Lightning CSS performs advanced engineering optimizations",
    "esbuild:expanded": "npx esbuild src/index.css --bundle --outfile=dist/grayscale.css",
    "esbuild:minified": "npx esbuild src/index.css --bundle --minify --outfile=dist/grayscale.min.css",
    "esbuild": "npm run esbuild:expanded && npm run esbuild:minified"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "lightningcss-cli": "^1.33.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
