{
  "name": "monocrome-scss",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "// --- Lightning CSS : Build Tasks --- //": "alternative of comment",
    "build:expanded": "npx lightningcss --bundle src/index.css -o build/library.css",
    "build:minified": "npx lightningcss --bundle --minify src/index.css -o build/library.min.css",
    "build": "npm run build:expanded && npm run build:minified",
    "dev:watch": "npx lightningcss --bundle --watch src/index.css -o build/library.css",
    "dev:serve": "serve build",
    "lint": "npx stylelint src/**/*.css"
  },
  "xscripts": {
    "note": " only one script can be present. remove x to apply below scripts",
    "// --- esbuild Tasks --- //": "While tools like esbuild just strip whitespace, Lightning CSS performs advanced engineering optimizations",
    "esbuild:expanded": "npx esbuild src/index.css --bundle --outfile=dist/library.css",
    "esbuild:minified": "npx esbuild src/index.css --bundle --minify --outfile=dist/library.min.css",
    "esbuild": "npm run esbuild:expanded && npm run esbuild:minified"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lightningcss-cli": "^1.33.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
